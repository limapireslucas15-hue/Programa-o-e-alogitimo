Program tabuada;
var
n,n1,n2,n3,n4,n5,n6,n7,n8,n9,n10:integer;
Begin
write('Digite um numero para começar a tabuada:');
read(n);
n1:= n*1;
n2:= n*2;
n3:= n*3;
n4:= n*4;
n5:= n*5;
n6:= n*6;
n7:= n*7;
n8:= n*8;
n9:= n*9;
n10:= n*10;
   writeln('A tabuada de ', n, ' e:');
  writeln(n, ' x 1 = ', n1);
  writeln(n, ' x 2 = ', n2);
  writeln(n, ' x 3 = ', n3);
  writeln(n, ' x 4 = ', n4);
  writeln(n, ' x 5 = ', n5);
  writeln(n, ' x 6 = ', n6);
  writeln(n, ' x 7 = ', n7);
  writeln(n, ' x 8 = ', n8);
  writeln(n, ' x 9 = ', n9);
  writeln(n, ' x 10 = ', n10);
End.